#!/usr/bin/env python3
import argparse
from _sdd import workspace, git

parser = argparse.ArgumentParser()
parser.add_argument('plan')
parser.add_argument('base')
parser.add_argument('head')
args = parser.parse_args()
base = git('rev-parse','--verify',args.base+'^{commit}')
head = git('rev-parse','--verify',args.head+'^{commit}')
out = workspace(args.plan) / f'review-{base[:12]}-{head[:12]}.md'
text = f'# Review package\n\nRange: {base}..{head}\n\n## Commits\n\n'
text += git('log','--oneline',base+'..'+head)
text += '\n\n## Files changed\n\n' + git('diff','--stat',base,head)
text += '\n\n## Diff\n\n' + git('diff',base,head) + '\n'
out.write_text(text)
print(out)
