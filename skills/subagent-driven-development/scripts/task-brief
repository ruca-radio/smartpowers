#!/usr/bin/env python3
import argparse
from _sdd import workspace, task_text

parser = argparse.ArgumentParser()
parser.add_argument('plan')
parser.add_argument('number', type=int)
args = parser.parse_args()
if args.number < 0:
    parser.error('Task number cannot be negative')
text = task_text(args.plan, args.number)
out = workspace(args.plan) / f'task-{args.number}-brief.md'
out.write_text(text)
print(out)
